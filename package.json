{
  "name": "dsh-prompt-presets",
  "version": "0.1.1",
  "description": "Content-free prompt profile editor and versioned composition framework for DeepSeek Harness",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./core/profile": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "esbuild": "^0.25.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LiweiDonVee/dsh-prompt-presets.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "prompt-editor"
  ],
  "bugs": {
    "url": "https://github.com/LiweiDonVee/dsh-prompt-presets/issues"
  }
}
